# Copy to /etc/webstore/webstore.env (mode 0600). Never commit a filled copy.

# --- Lab addressing ---
# webapp01 / webapp02 last octets are NOT invented. Deploy fills them from
# ansible_default_ipv4.address (or getent on each host).
WEBAPP01_HOST=webapp01.lab.rippa.io
WEBAPP02_HOST=webapp02.lab.rippa.io
WEBAPP01_IP=
WEBAPP02_IP=
SHOP_VIP_DNS=shoppingapp.lab.rippa.io
# Allocated unused address on 10.10.4.0/24 (not .110). Confirm it is free before keepalived starts.
SHOP_VIP_IP=10.10.4.50
GARB_D_HOST=second-demo.lab.rippa.io
GARB_D_IP=10.10.4.110

# --- Secrets (replace before production) ---
JWT_SECRET=change-me-lab-jwt-secret-not-for-production
INTERNAL_TOKEN=change-me-lab-internal-token
MARIADB_ROOT_PASSWORD=change-me-lab-root
MARIADB_PASSWORD=change-me-lab-webstore
MARIADB_SST_PASSWORD=change-me-lab-sst
LDAP_MANAGER_PASSWORD=change-me-lab-dirmgr
LDAP_API_PASSWORD=change-me-lab-api-bind
KEEPALIVED_PASS=shopvrrp
SYNTH_PASSWORD=change-me-lab-synth

# --- Service URLs (containers on a shop host) ---
DATABASE_URL=mysql+pymysql://webstore:change-me-lab-webstore@mariadb:3306/webstore
BACKEND_URL=http://backend:8001
# Peer backend published on the other shop host (filled by Ansible).
PEER_BACKEND_URL=
LDAP_URL=ldap://host.containers.internal:389
LDAP_PEER_URL=
LDAP_BASE_DN=dc=webstore,dc=local
LDAP_PEOPLE_OU=ou=People,dc=webstore,dc=local
LDAP_SERVICE_DN=uid=api,ou=Services,dc=webstore,dc=local
JWT_EXPIRE_MINUTES=30

# synth-users on second-demo
STORE_BASE_URL=http://shoppingapp.lab.rippa.io
SYNTH_COUNT=100
SYNTH_MIN_SEC=15
SYNTH_MAX_SEC=45
